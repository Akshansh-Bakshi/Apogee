# Copy this file to `.env` (repo root) and fill in the blanks.
# `.env` is git-ignored. Never commit real credentials.

ENVIRONMENT=development

# PostgreSQL connection. When running the API on your host machine, POSTGRES_HOST is
# `localhost`. docker-compose overrides it to `db` for the backend container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=apogee
POSTGRES_USER=apogee

# REQUIRED - there is intentionally no default. Generate one, e.g.:
#   openssl rand -hex 24
# (Hex avoids characters such as `$` that docker-compose would try to interpolate.)
POSTGRES_PASSWORD=

# Seconds to wait when opening a database connection (keeps /health from hanging).
DB_CONNECT_TIMEOUT_SECONDS=5
